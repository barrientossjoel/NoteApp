{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/ping",
            "destination": "/api/ping.js"
        },
        {
            "source": "/api/test_hono",
            "destination": "/api/test_hono.js"
        },
        {
            "source": "/api/test",
            "destination": "/api/test.ts"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        }
    ]
}